  "tie_breaking_control": {
    "question": "Sprint 5's frozen-pool gain (+0.0022) was TIE-BREAKING, not optimization: rounding the solved scores to six decimals returned the metric to the uniform value. Does the mixed pool's +0.0076 survive the same control?",
    "seed": 42,
    "rounding_test": {
      "note": "AP after rounding solved scores to N decimal places, with the resulting distinct-score count",
      "solved_6dp": {
        "ap": 0.7703,
        "distinct": 855
      },
      "solved_4dp": {
        "ap": 0.7703,
        "distinct": 549
      },
      "solved_3dp": {
        "ap": 0.7701,
        "distinct": 242
      },
      "solved_2dp": {
        "ap": 0.7693,
        "distinct": 96
      },
      "uniform": {
        "ap": 0.7607,
        "distinct": 123
      },
      "verdict": "SURVIVES. At 2dp the solved scores carry FEWER distinct values than uniform (96 vs 123) yet still score 0.7693 against uniform's 0.7607. The advantage cannot be tie-breaking, because the coarsened scores have less resolution than the comparator."
    },
    "shrinkage_test": {
      "note": "w(a) = uniform + a*(solved - uniform); AP as weights move from uniform to the optimum",
      "points": [
        {
          "a": 0.0,
          "l1": 0.0,
          "ap": 0.7607
        },
        {
          "a": 0.25,
          "l1": 0.0318,
          "ap": 0.7629
        },
        {
          "a": 0.5,
          "l1": 0.0635,
          "ap": 0.7663
        },
        {
          "a": 0.75,
          "l1": 0.0953,
          "ap": 0.7676
        },
        {
          "a": 1.0,
          "l1": 0.127,
          "ap": 0.7703
        }
      ],
      "verdict": "MONOTONE. AP rises steadily with distance from uniform. Tie-breaking noise would not produce a monotone dose-response in the weight displacement."
    },
    "conclusion": "The mixed-pool advantage is optimization, unlike the frozen pool's. It is nonetheless +0.0076 mean against an A5 MDE of 0.0268, so it is reported as DIRECTIONAL ONLY: consistent across 10 of 10 seeds, below our own pre-registered detectable threshold, and not a win."
  }
