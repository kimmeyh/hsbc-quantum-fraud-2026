#!/bin/sh
# Pre-commit gate. Tracked in git (IMP-3, Sprint 22 retrospective) so every
# clone, and the Phase 2 repository started from this one, gets it. Enable it
# once per clone:  git config core.hooksPath .githooks
#
# 1. Confidentiality: block commits containing sensitive patterns or files.
#    Patterns live in .secrets-patterns.txt (gitignored, local-only) so the
#    patterns themselves never enter the repository.
# 2. CHANGELOG: a commit that changes code must also change CHANGELOG.md, as
#    the file's own policy requires. That policy failed twice on memory alone
#    (F70, 2026-09; Sprint 22). No override flag: a commit that genuinely
#    needs no entry is rare enough to get one line in the CHANGELOG anyway.

staged=$(git diff --cached --name-only)

if echo "$staged" | grep -qE '(^|/)\.env$'; then
  echo "BLOCKED: .env is staged. Unstage it (git restore --staged .env)."
  exit 1
fi

if [ -f .secrets-patterns.txt ]; then
  files=$(git diff --cached --name-only --diff-filter=ACM)
  if [ -n "$files" ]; then
    hits=$(echo "$files" | xargs git diff --cached -- 2>/dev/null | grep '^+' | grep -nEf .secrets-patterns.txt)
    if [ -n "$hits" ]; then
      echo "BLOCKED: staged changes match confidential patterns in .secrets-patterns.txt:"
      echo "$hits" | head -5
      exit 1
    fi
  fi
fi

code=$(echo "$staged" | grep -E '^(experiments/.*\.py|scripts/|\.claude/hooks/|\.githooks/)')
if [ -n "$code" ] && ! echo "$staged" | grep -qx 'CHANGELOG.md'; then
  echo "BLOCKED: this commit changes code but not CHANGELOG.md."
  echo "The CHANGELOG policy is: an entry in the SAME commit as the change."
  echo "Code staged:"
  echo "$code" | head -5
  exit 1
fi

exit 0
